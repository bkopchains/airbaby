{
  "name": "airbaby",
  "homepage": "https://www.airbabysolutions.com/",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "deploy": "npm run build && gh-pages -d dist -t --nojekyll",
    "kit:use-local": "npm pkg set dependencies.airbaby-ui=file:../airbaby-ui && npm install",
    "kit:use-npm": "npm pkg set dependencies.airbaby-ui=^0.1.0 && npm install"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.1.0",
    "airbaby-ui": "file:../airbaby-ui",
    "clsx": "^2.1.0",
    "react": "^18",
    "react-dom": "^18",
    "react-router": "^7.8.2",
    "react-select": "^5.10.2"
  },
  "devDependencies": {
    "@fontsource/lexend": "^5.2.8",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.16",
    "gh-pages": "^6.3.0",
    "typescript": "^5",
    "vite": "^5.4.11"
  }
}
